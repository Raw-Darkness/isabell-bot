[Unit]
Description=Isabell chat and image bot
After=network-online.target
Wants=network-online.target

[Service]
User=boss
WorkingDirectory=/home/boss/Isabell
ExecStart=/home/boss/Isabell/venv/bin/python -m isabell
Restart=always
RestartSec=5
# 78 = missing/rejected token or unapproved intent: a human has to fix it.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
